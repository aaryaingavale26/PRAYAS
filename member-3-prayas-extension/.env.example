# PRAYAS 3.0 - Environment Configuration Template
# Team ByteShastra | Chrome Extension & Backend API Integration

# Member 2: FastAPI Backend Base URL
BACKEND_URL=http://localhost:8000

# Authentication & Supabase (Kept securely on FastAPI server)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Google Gemini API Key (Kept strictly on FastAPI backend - never exposed in extension)
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Extension Test User Token (Mock bearer token for local development)
PRAYAS_TEST_BEARER_TOKEN=prayas_test_jwt_session_token
