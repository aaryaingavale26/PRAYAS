{
  "manifest_version": 3,
  "name": "PRAYAS 3.0 - Accessible Job Application Assistant",
  "version": "1.0.0",
  "description": "Empowering job seekers with disabilities through accessible form navigation, profile autofill, and live accessibility auditing.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PRAYAS 3.0 Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js", "content/voice-bundle.js"],
      "css": ["content/content.css", "content/voice-widget.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ]
}
